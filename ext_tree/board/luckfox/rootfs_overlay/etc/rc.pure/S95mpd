#!/bin/sh
# MPD plays Yandex Music: ymusicd (S96ymusicd) fills its queue

start() {
    printf "Starting MPD: "
    /usr/bin/mpd /etc/mpd.conf > /dev/null 2>&1
    sleep 0.5
    pidof mpd >/dev/null && echo "OK" || echo "FAIL"
    if [ -f /tmp/mixer_control_cache ]; then
        MIXER=$(cat /tmp/mixer_control_cache | cut -d, -f1 | tr -d "'")
        [ -n "$MIXER" ] && amixer set "$MIXER" unmute 2>/dev/null
    fi
}
stop() {
    killall -9 mpd 2>/dev/null
}
restart() {
	stop
	start
}
case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
