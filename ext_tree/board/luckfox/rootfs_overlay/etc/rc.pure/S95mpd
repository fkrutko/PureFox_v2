#!/bin/sh
# MPD (UPnP): upmpdcli is the UPnP/OpenHome renderer, MPD plays what it queues

# Name shown to UPnP control points, unique per board like the NAA name:
# hostname + last 3 octets of the eth0 MAC
upnp_name() {
    ID=$(cat /sys/class/net/eth0/address 2>/dev/null | tr -d ':' | tr 'a-z' 'A-Z')
    [ -z "$ID" ] && ID=$(awk '/Serial/ {print $NF}' /proc/cpuinfo | tr 'a-z' 'A-Z')
    ID=$(echo "$ID" | tail -c 7)
    if [ -n "$ID" ]; then
        echo "$(hostname)-$ID"
    else
        hostname
    fi
}

# MPD config: /etc/mpd.conf, or with RESAMPLE_48=1 in /etc/i2s.conf (no 48 kHz
# oscillator) a copy in /tmp where the ALSA output allows only the 44.1 kHz
# family and DSD: a 48 kHz family stream goes through soxr to the same
# multiple of 44.1 kHz (48 -> 44.1, 96 -> 88.2, 192 -> 176.4 kHz), 44.1 kHz
# family and DSD stay bit-perfect
mpd_conf() {
    if grep -q '^RESAMPLE_48=1' /etc/i2s.conf 2>/dev/null; then
        awk '{ print }
             /^[ \t]*auto_format[ \t]/ {
                 print "\tallowed_formats\t\"44100:*:* 88200:*:* 176400:*:* 352800:*:* 705600:*:* 22050:*:* 11025:*:* *:dsd:*\""
             }
             END { print "\nresampler {\n\tplugin\t\t\"soxr\"\n\tquality\t\t\"very high\"\n}" }' \
            /etc/mpd.conf > /tmp/mpd.conf
        echo /tmp/mpd.conf
    else
        echo /etc/mpd.conf
    fi
}

start() {
    printf "Starting MPD (UPnP): "
    /usr/bin/mpd "$(mpd_conf)" > /dev/null 2>&1
    mkdir -p /tmp/upmpdcli && chown upmpdcli /tmp/upmpdcli
    /usr/bin/upmpdcli -D -c /etc/upmpdcli.conf -f "$(upnp_name)" > /dev/null 2>&1
    sleep 0.5
    pidof mpd >/dev/null && pidof upmpdcli >/dev/null && echo "OK" || echo "FAIL"
    if [ -f /tmp/mixer_control_cache ]; then
        MIXER=$(cat /tmp/mixer_control_cache | cut -d, -f1 | tr -d "'")
        [ -n "$MIXER" ] && amixer set "$MIXER" unmute 2>/dev/null
    fi
}
stop() {
    killall -9 upmpdcli 2>/dev/null
    killall -9 mpd 2>/dev/null
}
restart() {
	stop
	start
}
case "$1" in
  start|stop|restart)
	"$1"
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?
