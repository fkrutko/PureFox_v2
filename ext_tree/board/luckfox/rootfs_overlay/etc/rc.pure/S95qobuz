#!/bin/sh

get_output_device() {
    if [ -f /etc/output ] && grep -q "USB" /etc/output; then
        echo "hw:1"
    else
        echo "default"
    fi
}

restore_mixer() {
    [ -f /tmp/mixer_control_cache ] || return 0

    mixer=$(cut -d, -f1 /tmp/mixer_control_cache | tr -d "'")
    [ -n "$mixer" ] && amixer set "$mixer" unmute 2>/dev/null
}

start_qobuz_proxy() {
    target="$(cat /tmp/qobuz_proxy_target 2>/dev/null)"
    blocked="$(cat /tmp/qobuz_geo 2>/dev/null)"
    [ "$blocked" = "1" ] || return 0
    [ -n "$target" ] || return 0

    proxy_host="${target%%:*}"
    proxy_port="${target##*:}"
    [ -n "$proxy_host" ] || return 0
    [ -n "$proxy_port" ] || proxy_port=8443

    killall rinetd tinyproxy 2>/dev/null
    /bin/sh -c 'renice 15 $$ >/dev/null 2>&1; exec /usr/sbin/rinetd 127.0.0.1 443 "$1" "$2"' sh \
        "$proxy_host" "$proxy_port" >/dev/null 2>&1 &
    /bin/sh -c 'renice 15 $$ >/dev/null 2>&1; exec tinyproxy -c /etc/tinyproxy.conf' \
        >/dev/null 2>&1 &
}

stop_qobuz_proxy() {
    killall rinetd tinyproxy 2>/dev/null
}

start_qobuz() {
    output_device="$(get_output_device)"

    export LD_PRELOAD=/usr/lib/libassert_hook.so
    /bin/sh -c 'export LD_PRELOAD=/usr/lib/libassert_hook.so; renice -15 $$ >/dev/null 2>&1; exec /opt/qobuz-connect/qobuz-connect -o "$1"' sh \
        "$output_device" > /dev/null 2>&1 &

    restore_mixer
}

start() {
    printf "Starting Qobuz Connect: "
    start_qobuz_proxy
    start_qobuz > /dev/null 2>&1 &
}

stop() {
    pid="$(pidof qobuz-connect)"

    if [ -n "$pid" ]; then
        kill -9 "$pid"
        stop_qobuz_proxy
        echo "Stopped qobuz-connect (PID: $pid)"
    else
        stop_qobuz_proxy
        echo "qobuz-connect not running"
    fi
}

restart() {
    stop
    start
}

case "$1" in
    start|stop|restart)
        "$1"
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit $?
