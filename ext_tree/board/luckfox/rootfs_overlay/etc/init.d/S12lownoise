#!/bin/sh
#
# Low noise settings of the web page (/etc/lownoise.conf, /opt/lownoise.sh)
#

case "$1" in
    start|restart|reload)
        printf "Applying low noise settings: "
        /opt/lownoise.sh apply && echo "OK" || echo "FAIL"
        ;;
    stop)
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
esac

exit 0
