Build the PureFox device trees and keep USB DSD quirks in line with 6.1

Lists the PureFox DTBs in the 5.10 DTS Makefile (as in PureFox 1.x) and
adds the Comture vendor id to the generic native-DSD quirk, as the 6.1
patch does with QUIRK_FLAG_DSD_RAW.

--- a/arch/arm/boot/dts/Makefile
+++ b/arch/arm/boot/dts/Makefile
@@ -971,7 +971,10 @@
 	r8a7794-silk.dtb \
 	r9a06g032-rzn1d400-db.dtb \
 	sh73a0-kzm9g.dtb 
-# dtb-$(CONFIG_ARCH_ROCKCHIP) += \
+dtb-$(CONFIG_ARCH_ROCKCHIP) += \
+	rv1106_ext.dtb \
+	rv1106_512_ext.dtb \
+	rv1106_pll.dtb
 #	rv1103g-38x38-ipc-v10.dtb \
 #	rv1103g-battery-ipc-v10.dtb \
 #	rv1103g-battery-ipc-v11.dtb \
--- a/sound/usb/quirks.c
+++ b/sound/usb/quirks.c
@@ -1821,6 +1821,7 @@
 	case 0x292b:  /* Gustard/Ess based devices */
 	case 0x2972:  /* FiiO devices */
 	case 0x2ab6:  /* T+A devices */
+	case 0x2fc6:  /* Comture-inc devices */
 	case 0x3353:  /* Khadas devices */
 	case 0x3842:  /* EVGA */
 	case 0xc502:  /* HiBy devices */
