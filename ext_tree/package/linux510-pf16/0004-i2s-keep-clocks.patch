From: Fedor Krutko <fkrutko@gmail.com>
Subject: ASoC: rockchip: i2s-tdm: keep clocks running between PCM streams

The keep_clocks option of the 6.1/5.10 driver (ext_tree/patches/
linux_rv1106.patch), ported to the PureFox 1.6 driver. With sysfs
keep_clocks=1, STOP and PAUSE of a PCM stream only stop the DMA: two frames
of zeros go into the TX FIFO and BCLK/LRCK keep running with silence, so the
DAC stays locked and does not lose the start of the next track. The next PCM
stream takes the running bus over. DSD always stops the bus. Default 0 keeps
the PureFox 1.6 behaviour.

--- a/sound/soc/rockchip/rockchip_i2s_tdm.c
+++ b/sound/soc/rockchip/rockchip_i2s_tdm.c
@@ -155,6 +155,11 @@
     /* Add pause state */
     bool playback_paused;
     bool capture_paused;
+
+    /* Keep BCLK/LRCK running between PCM streams (sysfs keep_clocks) */
+    bool keep_clocks;
+    bool clocks_held;               /* bus running with no stream on it */
+    bool pause_kept;                /* paused with the bus left running */
     
     /* Debounce for auto-mute */
     unsigned long last_auto_mute_time;
@@ -769,6 +774,121 @@
     return i2s_tdm->capture_paused;
 }
 
+/*
+ * Keep the I2S clocks running between PCM streams (sysfs keep_clocks).
+ *
+ * Normally STOP and PAUSE halt BCLK/LRCK. Many DACs then lose lock and take
+ * a second or more to lock again when the next stream starts, so the start
+ * of a track goes missing; some also click relays or reset their display.
+ * With keep_clocks on, a PCM stream that stops or pauses only stops its
+ * DMA: the transmitter keeps running with silence (zeros) and the DAC stays
+ * locked. The next PCM stream takes the running bus over. A change of rate
+ * or format still reprograms the bus (rockchip_i2s_tdm_params_trcm).
+ *
+ * DSD always stops the bus: zero data is no DSD silence, and some DACs and
+ * converters misbehave on a clocked DSD bus without data.
+ *
+ * While the bus runs without a stream the driver holds a runtime PM
+ * reference (runtime suspend would gate MCLK) and, in TRCM mode, the
+ * transfer reference the stopped stream owned.
+ *
+ * Same code as in the 6.1/5.10 driver (ext_tree/patches/linux_rv1106.patch).
+ */
+
+/* TX FIFO words per frame: DMA writes 32-bit words, so two 16-bit samples
+ * share a word and wider samples take one each */
+static unsigned int rockchip_i2s_tdm_tx_frame_words(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    unsigned int txcr = 0, vdw, words;
+
+    regmap_read(i2s_tdm->regmap, I2S_TXCR, &txcr);
+    vdw = ((txcr & I2S_TXCR_VDW_MASK) >> I2S_TXCR_VDW_SHIFT) + 1;
+    words = to_ch_num(txcr & I2S_TXCR_CSR_MASK);
+    if (vdw <= 16)
+        words = max(words / 2, 1u);
+    return words;
+}
+
+/* Stop the playback DMA but leave the bus running. The FIFO still holds the
+ * last samples; two frames of zeros go after them, so the line ends on
+ * silence whatever the transmitter sends once the FIFO is empty. DMA always
+ * writes whole frames, so the zeros start on a frame boundary. */
+static void rockchip_i2s_tdm_idle_tx(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    unsigned int i, words;
+
+    rockchip_i2s_tdm_dma_ctrl(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK, 0);
+    words = 2 * rockchip_i2s_tdm_tx_frame_words(i2s_tdm);
+    for (i = 0; i < words; i++)
+        regmap_write(i2s_tdm->regmap, I2S_TXDR, 0);
+}
+
+/* Feed a bus that kept running without data. The FIFO ran dry meanwhile.
+ * With one FIFO word per frame (16-bit stereo) the next word still starts a
+ * frame and the bus just goes on. With a word per sample the transmitter may
+ * pick the data up in the right channel's slot, so do the STOP-CLEAR-START
+ * Rockchip suggests for always-on buses: LRCK stops for ~0.2 ms instead of
+ * for the whole gap between streams. */
+static void rockchip_i2s_tdm_feed_tx(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    if (rockchip_i2s_tdm_tx_frame_words(i2s_tdm) > 1) {
+        rockchip_i2s_tdm_xfer_stop(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK, true);
+        rockchip_i2s_tdm_dma_ctrl(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK, 1);
+        rockchip_i2s_tdm_xfer_start(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK);
+    } else {
+        rockchip_i2s_tdm_dma_ctrl(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK, 1);
+    }
+}
+
+/* May this playback stream leave the bus running when it stops or pauses? */
+static bool rockchip_i2s_tdm_can_keep_clocks(struct rk_i2s_tdm_dev *i2s_tdm,
+                                             struct snd_pcm_substream *substream)
+{
+    return i2s_tdm->keep_clocks && i2s_tdm->is_master_mode && substream &&
+           substream->stream == SNDRV_PCM_STREAM_PLAYBACK &&
+           !i2s_tdm->dsd_mode_active && !is_dsd(substream->runtime->format) &&
+           is_stream_active(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK);
+}
+
+/* STOP of a PCM stream: leave the bus running with silence */
+static void rockchip_i2s_tdm_hold_clocks(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    unsigned long flags;
+
+    rockchip_i2s_tdm_idle_tx(i2s_tdm);
+    pm_runtime_get_noresume(i2s_tdm->dev);
+    spin_lock_irqsave(&i2s_tdm->lock, flags);
+    i2s_tdm->clocks_held = true;
+    spin_unlock_irqrestore(&i2s_tdm->lock, flags);
+    dev_dbg(i2s_tdm->dev, "Playback stopped, I2S clocks kept running\n");
+}
+
+/* Take a running bus over; false when the bus was not held */
+static bool rockchip_i2s_tdm_take_clocks(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    unsigned long flags;
+    bool held;
+
+    spin_lock_irqsave(&i2s_tdm->lock, flags);
+    held = i2s_tdm->clocks_held;
+    i2s_tdm->clocks_held = false;
+    spin_unlock_irqrestore(&i2s_tdm->lock, flags);
+    return held;
+}
+
+/* Stop a held bus: keep_clocks turned off, a DSD stream comes, removal */
+static void rockchip_i2s_tdm_release_clocks(struct rk_i2s_tdm_dev *i2s_tdm)
+{
+    if (!rockchip_i2s_tdm_take_clocks(i2s_tdm))
+        return;
+    if (i2s_tdm->clk_trcm)
+        rockchip_i2s_tdm_xfer_trcm_stop(i2s_tdm);
+    else
+        rockchip_i2s_tdm_xfer_stop(i2s_tdm, SNDRV_PCM_STREAM_PLAYBACK, false);
+    pm_runtime_put(i2s_tdm->dev);
+    dev_dbg(i2s_tdm->dev, "Held I2S clocks stopped\n");
+}
+
 static void rockchip_i2s_tdm_start(struct rk_i2s_tdm_dev *i2s_tdm, int stream)
 {
     /* Check if stream is in pause state */
@@ -779,6 +899,14 @@
 
