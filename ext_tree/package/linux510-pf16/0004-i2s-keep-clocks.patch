+/* Keep BCLK/LRCK running between PCM streams: 0 or 1 */
+static ssize_t keep_clocks_show(struct device *dev,
+                                struct device_attribute *attr, char *buf)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+
+    return sprintf(buf, "%d\n", i2s_tdm->keep_clocks ? 1 : 0);
+}
+
+static ssize_t keep_clocks_store(struct device *dev,
+                                 struct device_attribute *attr,
+                                 const char *buf, size_t count)
+{
+    struct rk_i2s_tdm_dev *i2s_tdm = dev_get_drvdata(dev);
+    int value;
+
+    if (sscanf(buf, "%d", &value) != 1 || (value != 0 && value != 1))
+        return -EINVAL;
+
+    i2s_tdm->keep_clocks = value;
+    if (!value)
+        rockchip_i2s_tdm_release_clocks(i2s_tdm);
+    dev_info(dev, "Keep I2S clocks between streams: %s\n", value ? "ON" : "OFF");
+
+    return count;
+}
+
+static DEVICE_ATTR(keep_clocks, 0644, keep_clocks_show, keep_clocks_store);
