# Spotify Connect (librespot)
# Confirmed from librespot binary strings (v0.8.x):
# API / OAuth
accounts.spotify.com
apresolve.spotify.com
clienttoken.spotify.com
login5.spotify.com
# Access point (TCP binary protocol)
ap.spotify.com
# Dealer (WebSocket control channel)
dealer.spotify.com
# Spclient (metadata, streaming manifests, CDN resolution)
spclient.wg.spotify.com
# Image CDN (album art, playlists)
i.scdn.co
# Audio CDN (Akamai / Fastly / Edgesuite) — resolved dynamically
audio-ak-spotify-com.akamaized.net
audio4-ak-spotify-com.akamaized.net
audio-cf.spotifycdn.com
audio-gm-off.spotifycdn.com
heads-ak-spotify-com.akamaized.net
heads4-ak-spotify-com.akamaized.net
spotify.com.edgesuite.net
spotify.map.fastly.net
spotify.map.fastlylb.net
# Static assets / CDN (v2fly community list)
scdn.co
spotifycdn.com
spotifycdn.net
# Catch-all
spotify.com

