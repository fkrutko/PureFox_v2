config BR2_PACKAGE_YMUSIC
	bool "ymusic"
	depends on BR2_TOOLCHAIN_HAS_THREADS
	select BR2_PACKAGE_LIBCURL
	select BR2_PACKAGE_OPENSSL
	select BR2_PACKAGE_CA_CERTIFICATES
	help
	  Yandex Music for MPD (ported from DigiFox). ymusicd on port 6601
	  serves a JSON API for a desktop app (login, browse, search, queue,
	  My Wave, playback control) and decrypted track streams (encraw,
	  AES-128-CTR) to MPD, refilling "My Wave" in the MPD queue.
