# The board runs these files as they are: shell scripts with Windows line
# endings fail with "not found". Keep LF in every checkout of the files
# that go to the board, Windows included; binaries are detected and left alone.
ext_tree/** text=auto eol=lf
*.sh text=auto eol=lf
# imported with CRLF, kept byte for byte
ext_tree/package/snd-screamalsa/snd-screamalsa.c -text
